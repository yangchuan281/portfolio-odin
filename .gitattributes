# 统一用 LF，避免 Windows 检出后 shell 脚本在 Linux/CI 里报 \r 错误
* text=auto eol=lf

*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.j2    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

*.png   binary
*.jpg   binary
*.webp  binary
*.woff2 binary
*.ico   binary
